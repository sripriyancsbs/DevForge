# DevForge Platform Environment Configuration

# Application
APP_NAME=DevForge
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=devforge_super_secret_development_key_change_in_production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database (PostgreSQL)
POSTGRES_USER=devforge
POSTGRES_PASSWORD=devforge_secure_password
POSTGRES_DB=devforge_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://devforge:devforge_secure_password@postgres:5432/devforge_db

# Frontend Configuration
VITE_API_BASE_URL=/api/v1
