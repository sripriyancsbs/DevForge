# DevForge Internal Developer Platform (IDP) — Environment Configuration Template
# Copy to .env and adjust values for your environment.

# Platform Environment (development, staging, production)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change_this_to_a_secure_random_string_in_production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# PostgreSQL Database Configuration (Required — SQLite is strictly disabled)
POSTGRES_USER=devforge
POSTGRES_PASSWORD=devforge_secure_password
POSTGRES_DB=devforge_db
POSTGRES_PORT=5432

# In Docker Compose, the database host is 'postgres'
# In local standalone development, the database host is '127.0.0.1' or 'localhost'
POSTGRES_HOST=postgres
DATABASE_URL=postgresql://devforge:devforge_secure_password@postgres:5432/devforge_db

# Frontend API Base URL
VITE_API_BASE_URL=/api/v1

# GitHub Integration Configuration (Phase 3)
# Personal Access Token with 'repo' scope (classic token or fine-grained repository token)
# NEVER commit the real token. Leave blank in templates.
GITHUB_TOKEN=
GITHUB_OWNER=sripriyancsbs
